# Backend (apps/api)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Anthropic — required from Phase 4 onward for the agent layer.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Frontend (apps/web)
# Used at build time. In dev, Vite proxies /api → localhost:3001 automatically.
VITE_API_URL=http://localhost:3001
