# orbit.ctrl — environment variables.
#
# Copy to `.env` (also at the repo root) and fill in. The API loads this file
# at startup via apps/api/src/config/dotenv.ts. Platform secrets (SnapDeploy
# dashboard env vars, GitHub Actions secrets) override anything set here.

# ── Backend (apps/api) ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Agent layer ─────────────────────────────────────────────────────────────
# The agent uses an ordered provider fallback chain: Gemini → Groq → Anthropic.
# Each provider is optional — configure as many as you like. At least one key
# is required for the /agent/chat route to be available.
#
# On failure, the orchestrator advances to the next configured provider
# automatically, so the demo stays live even when a free tier rate-limits.

# Primary: Google Gemini (free tier, recommended for the demo).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Fallback 1: Groq — open-source models (Llama 3.3 70B) with sub-second TTFT.
# Free tier, no credit card required. Get a key at https://console.groq.com/
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback 2: Anthropic Claude — highest quality, used as final backstop.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Frontend (apps/web) ─────────────────────────────────────────────────────
# Used at build time. In dev, Vite proxies /api → localhost:3001 automatically.
VITE_API_URL=http://localhost:3001
