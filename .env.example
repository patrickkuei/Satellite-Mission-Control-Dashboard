# orbit.ctrl — environment variables.
#
# Copy to `.env` (also at the repo root) and fill in. The API loads this file
# at startup via apps/api/src/config/dotenv.ts. Platform secrets (Fly.io,
# Vercel) override anything set here.

# ── Backend (apps/api) ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ── Agent layer (Phase 4) ───────────────────────────────────────────────────
# Provider selection. Defaults to gemini. Set to "anthropic" to switch.
# LLM_PROVIDER=gemini

# Primary: Google Gemini (free tier — recommended for the demo).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Secondary: Anthropic Claude.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Frontend (apps/web) ─────────────────────────────────────────────────────
# Used at build time. In dev, Vite proxies /api → localhost:3001 automatically.
VITE_API_URL=http://localhost:3001
